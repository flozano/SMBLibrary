<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Flozano.SMBLibrary</PackageId>
    <AssemblyName>SMBLibrary</AssemblyName>
    <Version>1.5.5.2</Version>
    <NoWarn>1573;1591</NoWarn>
    <RootNamespace>SMBLibrary</RootNamespace>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Tal Aloni, flozano</Authors>
    <Copyright>Copyright © Tal Aloni 2014-2025</Copyright>
    <PackageDescription>SMBLibrary fork with Socket overload support for SOCKS5 proxy connections. Based on the open-source C# SMB 1.0/CIFS, SMB 2.0, SMB 2.1 and SMB 3.0 server and client implementation.</PackageDescription>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/flozano/SMBLibrary</PackageProjectUrl>
    <RepositoryUrl>https://github.com/flozano/SMBLibrary</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>smb;cifs;smb2;smb3;socks5;proxy</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Utilities\Utilities.csproj" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Buffers">
      <Version>4.5.1</Version>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SMBLibrary.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

<!--  <Target Name="ILRepack" Condition="'$(Configuration)' == 'Release'" AfterTargets="AfterBuild">-->
<!--    <Exec Command="&quot;$(ProgramW6432)\ILRepack\ILRepack.exe&quot; /out=&quot;$(OutputPath)\SMBLibrary.dll&quot; &quot;$(OutputPath)\SMBLibrary.dll&quot; &quot;$(OutputPath)\Utilities.dll&quot;" />-->
<!--  </Target>-->

</Project>
